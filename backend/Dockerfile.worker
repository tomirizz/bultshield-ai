FROM ghcr.io/gitleaks/gitleaks:v8.30.1 AS gitleaks

FROM python:3.12-slim-bookworm AS worker

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    HOME=/home/bultshield \
    SEMGREP_SEND_METRICS=off \
    SEMGREP_ENABLE_VERSION_CHECK=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 bultshield

COPY --from=gitleaks /usr/bin/gitleaks /usr/local/bin/gitleaks

WORKDIR /app/backend

COPY backend/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

COPY backend/requirements-semgrep.txt ./requirements-semgrep.txt
RUN python -m venv /opt/semgrep \
    && /opt/semgrep/bin/pip install --no-cache-dir -r requirements-semgrep.txt \
    && ln -s /opt/semgrep/bin/semgrep /usr/local/bin/semgrep

COPY --chown=bultshield:bultshield backend/ ./

USER bultshield

RUN git --version && gitleaks version && semgrep --version

CMD ["python", "-m", "app.worker"]
