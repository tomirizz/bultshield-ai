DATABASE_URL=postgresql+psycopg://bultshield:CHANGE_ME@postgres:5432/bultshield
APP_ENV=production
PORT=8080
FRONTEND_DIST=/app/frontend/dist
# Worker only: process time limits (seconds, 1..1800)
CLONE_TIMEOUT_SECONDS=120
GITLEAKS_TIMEOUT_SECONDS=180
SEMGREP_TIMEOUT_SECONDS=300
TRIVY_TIMEOUT_SECONDS=600
# Optional worker-owned disk directory; default ~/.cache/bultshield-jobs
# SCAN_WORKSPACE_ROOT=/home/bultshield/.cache/bultshield-jobs

# Stage 8: private model running on Bult.ai; never an external AI API
AI_ENABLED=false
AI_ENDPOINT=http://127.0.0.1:8081
AI_MODEL=qwen2.5-1.5b-instruct
AI_TIMEOUT_SECONDS=240

# Exact operator-approved HTTPS origins; configure on both app and worker. Empty disables web scans.
NUCLEI_ALLOWED_TARGETS=
NUCLEI_TIMEOUT_SECONDS=90

# Production requires GitHub login. Never put real secrets in this example.
AUTH_ENABLED=false
PUBLIC_URL=https://bultshield-app-bultshield-ai-brick.fin1.bult.app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN_KEY=
LEGACY_OWNER_GITHUB_ID=191625826

# Image scans: registries the worker may pull public images from (comma-separated). Empty disables image scans.
IMAGE_ALLOWED_REGISTRIES=
# IMAGE_SCAN_PLATFORM=linux/amd64
