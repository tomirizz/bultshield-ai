DATABASE_URL=postgresql+psycopg://bultshield:CHANGE_ME@postgres:5432/bultshield
APP_ENV=production
PORT=8080
FRONTEND_DIST=/app/frontend/dist
# Worker only: process time limits (seconds, 1..1800)
CLONE_TIMEOUT_SECONDS=120
GITLEAKS_TIMEOUT_SECONDS=180
SEMGREP_TIMEOUT_SECONDS=300
TRIVY_TIMEOUT_SECONDS=600
# Optional worker-owned disk directory; default ~/.cache/bultshield-jobs
# SCAN_WORKSPACE_ROOT=/home/bultshield/.cache/bultshield-jobs

# Stage 8: private model running on Bult.ai; never an external AI API
AI_ENABLED=false
AI_ENDPOINT=http://127.0.0.1:8081
AI_MODEL=qwen2.5-1.5b-instruct
AI_TIMEOUT_SECONDS=240
